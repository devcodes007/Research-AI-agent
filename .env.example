# Copy to .env and fill in. Never commit .env.
# Free Composio Hobby plan key (no card): composio.dev -> Dashboard -> API keys
COMPOSIO_API_KEY=

# No LLM API key is needed. The default mode writes one prompt per app to data/handoff/ and an agent
# (Claude Code in the original run, or any agent/person) writes data/handoff/<key>.answer.json.
ATLAS_MODEL=handoff
ATLAS_VERIFY_MODEL=handoff
ATLAS_ADJUDICATE_MODEL=handoff
ATLAS_HANDOFF_LABEL=Claude Sonnet 5.5 via Claude Code

# Optional: any LiteLLM model for fully automated runs, e.g. ATLAS_MODEL=ollama/qwen2.5:14b (free, local) or groq/...

# Shown on the page
ATLAS_REPO_URL=https://github.com/devcodes007/Research-AI-agent

# Web search backend. Composio search tools are restricted on free keys, so use the keyless one:
ATLAS_SEARCH_BACKEND=ddg
